# Copy this file to .env for local development. Never commit .env.
#
# Supabase → Project Settings → API Keys (or the Connect dialog).
# Use the project URL and the publishable key. Older projects label that
# same client key "anon". Both are safe in the browser only because
# Row Level Security is enabled. Never put a secret or service-role key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional legacy name. The app reads this only when the publishable key above is empty.
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
